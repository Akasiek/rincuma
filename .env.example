# Set a strong password. Easiest way is to just generate it with: openssl rand -hex 32
DB_PASS=
DB_USER=rincuma
DB_NAME=rincuma

APP_PORT=3000

# For local HTTP or a trusted LAN, set COOKIE_SECURE=false.
COOKIE_SECURE=true

# Admin account created on first startup, only when no users exist yet. Set both or neither.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allow anyone who can reach the app to create an account.
REGISTRATION_ENABLED=false
